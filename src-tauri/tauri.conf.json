{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MRMMR",
  "version": "0.6.5",
  "identifier": "com.user.mrmmr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Marvel Rivals Mod Manager Redux",
        "width": 1180,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost wss://sso.nexusmods.com; img-src 'self' data: https://*.nexusmods.com; font-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "emporeo",
    "category": "Utility",
    "copyright": "Copyright © 2026 emporeo",
    "shortDescription": "Marvel Rivals Mod Manager Redux",
    "longDescription": "A modern, lightweight mod manager for discovering, installing, and managing Marvel Rivals mods from Nexus Mods.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
